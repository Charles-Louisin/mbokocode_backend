# Copier vers backend/.env puis renseigner. Ne jamais commiter de vraie valeur.
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Origine du frontend et liste explicite des origines autorisées (séparées par des virgules).
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Nombre de proxys de confiance devant l'API (0 en local, 1 derrière Railway/Render).
TRUST_PROXY=0

# MongoDB Atlas — obligatoire en production.
MONGODB_URI=
MONGODB_DB_NAME=mbokocode

# UploadThing — nom choisi par le propriétaire, mappé vers UPLOADTHING_TOKEN au démarrage.
UPLOADTHING8TOKEN=
# Compatibilité uniquement si l'environnement utilise déjà le nom standard :
UPLOADTHING_TOKEN=

# Emails transactionnels (Resend). Sans clé, les demandes sont enregistrées mais aucun email ne part.
RESEND_API_KEY=
# Expéditeur vérifié dans Resend, par exemple : MBOKO CODE <contact@ton-domaine.com>
EMAIL_FROM=
# Destinataire des notifications (nouvelle demande, avis à relire). Par défaut : 1re adresse d'ADMIN_EMAILS.
ADMIN_NOTIFICATION_EMAIL=
ADMIN_EMAILS=

# Better Auth — secret aléatoire de 32 caractères minimum (obligatoire en production).
# Générer : node -e "console.log(require(crypto).randomBytes(32).toString(base64url))"
BETTER_AUTH_SECRET=
# URL publique où le navigateur joint /api/auth : le site Next.js, qui relaie /api/auth et /api/v1
# vers cette API (cookies first-party). Par défaut : FRONTEND_URL.
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (console Google Cloud > Identifiants). URI de redirection autorisée :
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phases suivantes (pas encore utilisées) :
# SENTRY_DSN=
